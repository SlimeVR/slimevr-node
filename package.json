{
  "name": "slimevr",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint --ext .ts,.tsx .",
    "format": "prettier --write \"**/*.{mts,ts,tsx,md,json}\"",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/plugin-transform-export-namespace-from": "^8.1.3",
    "@babel/plugin-transform-modules-commonjs": "^8.1.3",
    "@changesets/cli": "^3.0.3",
    "@slimevr/eslint-config": "workspace:*",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
